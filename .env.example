# Copier ce fichier en .env.local (c’est .env.local que Next lit au dev).
# Ne jamais committer .env.local.

# OBLIGATOIRE pour lancer l’app — sinon erreur MissingSecret (Auth.js).
# Nom exact : AUTH_SECRET (avec underscore _). Pas AUTH-SECRET.
# Dans .env.local uniquement, générer une valeur réelle, par ex. :
#   openssl rand -base64 32
# Ne pas laisser vide : générer avec « openssl rand -base64 32 »
AUTH_SECRET=remplacer-par-une-valeur-generee

# URL publique de l’app (obligatoire en prod, ex. https://xxx.vercel.app)
AUTH_URL=http://localhost:3000

# Compte unique (email en minuscules pour la comparaison)
# Dev par défaut : admin@example.com / admin (générer le hash ci-dessous)
AUTH_EMAIL=admin@example.com

# Sortie de : npm run hash-password -- "votre-mot-de-passe"
# Recommandé : la ligne AUTH_PASSWORD_HASH_BASE64=... (évite le bug Next sur les $ dans le PHC).
AUTH_PASSWORD_HASH_BASE64=

# Déconseillé en .env* : PHC en clair (les $ sont interprétés comme des variables).
# Si vraiment utilisé : échapper chaque $ en \$
AUTH_PASSWORD_HASH=
